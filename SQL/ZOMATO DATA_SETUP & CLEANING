-- Creation of a new database for zomato_analytics
CREATE DATABASE zomato_product_analytics;

--Creation of a new table called zomato_india and inport of the table:
CREATE TABLE zomato_india (
    restaurant_id INTEGER,
    restaurant_name VARCHAR(255),
    city VARCHAR(100),
    locality VARCHAR(255),
    cuisines VARCHAR(1000),
    average_cost_for_two NUMERIC,
    has_table_booking VARCHAR(10),
    has_online_delivery VARCHAR(10),
    is_delivering_now VARCHAR(10),
    price_range INTEGER,
    aggregate_rating NUMERIC,
    rating_text VARCHAR(50),
    votes INTEGER,
    latitude NUMERIC,
    longitude NUMERIC
);

-------------------------------------------------------------------------------------------
-- Verify the Import is sucessful: 
--We will ensure our data has been sucessfully transfered to our POSTgreSQL database:
select *
from zomato_india;

--We will check the count (total rows) availabe in zomato india
SELECT COUNT(*)
FROM zomato_india;

-- We will see the data preview for just 10 rows
SELECT *
FROM zomato_india
LIMIT 10;

-- Basic data-quality check section: 
-- Verify the total count, to know how many unique restaurants are available and to understand if there are duplicates in the table
SELECT
    COUNT(*) AS total_rows,
    COUNT(DISTINCT restaurant_id) AS unique_restaurants,
    COUNT(*) - COUNT(DISTINCT restaurant_id) AS duplicate_ids
FROM zomato_india;

-- Verify if there is null in any of the needed colunns:
SELECT
    COUNT(*) FILTER (WHERE city IS NULL) AS null_city,
    COUNT(*) FILTER (WHERE cuisines IS NULL) AS null_cuisines,
    COUNT(*) FILTER (WHERE aggregate_rating IS NULL) AS null_rating,
    COUNT(*) FILTER (WHERE average_cost_for_two IS NULL) AS null_cost
FROM zomato_india;

-- Check the minimum and maximum ranges for key numeric columns
SELECT
    MIN(average_cost_for_two) AS min_cost,
    MAX(average_cost_for_two) AS max_cost,
    MIN(aggregate_rating) AS min_rating,
    MAX(aggregate_rating) AS max_rating,
    MIN(votes) AS min_votes,
    MAX(votes) AS max_votes
FROM zomato_india;

-- Count total restaurants grouped by online delivery availability
SELECT
    has_online_delivery,
    COUNT(*) AS restaurants
FROM zomato_india
GROUP BY has_online_delivery;

-- We are going to see: Count restaurants with zero cost, zero ratings, or zero votes to find data gaps
SELECT COUNT(*) AS zero_cost
FROM zomato_india
WHERE average_cost_for_two = 0;

SELECT COUNT(*) AS zero_rating
FROM zomato_india
WHERE aggregate_rating = 0;

SELECT COUNT(*) AS zero_votes
FROM zomato_india
WHERE votes = 0;

--Count and rank restaurants by their text rating category (e.g., Excellent, Good, Poor)
SELECT
    rating_text,
    COUNT(*) AS restaurants
FROM zomato_india
GROUP BY rating_text
ORDER BY restaurants DESC;

